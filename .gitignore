# dependencies
/node_modules

# next.js
/.next/
/out/

# vault assets generated from content/posts at build time (copy-vault-images.mjs)
/public/vault/

# notes cloned from the external pensine repo at build time (fetch-notes.mjs)
/content/posts/

# concatenated note-page scripts generated by scripts/bundle-js.mjs
/public/js/note.bundle.js

# Anki decks extracted from .apkg at build time (scripts/build-anki.mjs)
/content/anki/
/public/anki/

# typescript build info
*.tsbuildinfo

# RAG index manifest cache (scripts/index-notes.mjs; persisted via CI cache)
/.cache/

# cloudflare pages / wrangler (local secrets + state)
.dev.vars
.wrangler/

# misc
.DS_Store

# JetBrains IDE
/.idea/
