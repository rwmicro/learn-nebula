# dependencies
/node_modules

# next.js
/.next/
/out/

# vault assets generated from content/posts at build time (copy-vault-images.mjs)
/public/vault/

# notes cloned from the external pensine repo at build time (fetch-notes.mjs)
/content/posts/

# concatenated note-page scripts generated by scripts/bundle-js.mjs
/public/js/note.bundle.js
/public/js/palette.bundle.js
/public/js/quiz.bundle.js
/public/js/glossary.bundle.js
/public/js/widgets-*.bundle.js

# mermaid UMD bundle copied in by scripts/copy-mermaid.mjs (client-render fallback)
/public/js/mermaid.min.js

# isometric figures built from figures/ (scripts/build-figures.mjs), and
# their local preview pages and screenshots
/public/figures/
/figures/*/preview*.html
/figures/*/shots/

# note share cards drawn at build time (scripts/build-og-images.ts)
/public/og/

# Anki decks extracted from .apkg at build time (scripts/build-anki.mjs)
/content/anki/
/public/anki/

# typescript build info
*.tsbuildinfo

# RAG index manifest cache (scripts/index-notes.mjs; persisted via CI cache)
/.cache/

# cloudflare pages / wrangler (local secrets + state)
.dev.vars
.wrangler/

# misc
.DS_Store

# JetBrains IDE
/.idea/

# Self-hosted server runtime data (RAG chunks/vectors, comments DB) — generated
/data/

# Local runtime secrets (docker/pnpm server) — never commit
.env
playwright-report/
# Playwright's per-failure artefacts, and the baselines toHaveScreenshot writes
# on a first run (none are tracked, so every fresh checkout regenerates them).
test-results/

content/vault-images.json
