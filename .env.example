# Runtime config for the self-hosted server (docker run --env-file .env …).
# Copy to .env and fill in. Everything is optional; unset features degrade
# gracefully (the frontend already handles 503s and empty results).

# ── Server ───────────────────────────────────────────────────────────────
PORT=8085
# TRUST_PROXY=true          # X-Forwarded-For is authoritative (default). Set
                            # "false" only if NOT behind a reverse proxy.

# ── Generation (pick ONE; Anthropic wins if both are set) ────────────────
# A) Anthropic (Claude) — hosted, best quality. This is the docker-compose
#    default; only the key is needed here (GEN_MODEL/TRANSLATE_MODEL are set to
#    claude-haiku-4-5-20251001 in docker-compose.yml — cheap/fast; swap to
#    claude-sonnet-5 or claude-opus-5 for higher quality):
ANTHROPIC_API_KEY=sk-ant-...
# GEN_MODEL=claude-haiku-4-5-20251001
# TRANSLATE_MODEL=claude-haiku-4-5-20251001
#
# B) Or any OpenAI-compatible chat endpoint (Ollama, llama.cpp, LM Studio) —
#    local, free. Leave ANTHROPIC_API_KEY unset if you use this:
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=your-local-chat-model

# ── RAG retrieval embeddings (OpenAI-compatible /v1/embeddings) ───────────
# Unset → the assistant answers from the model alone (no note grounding).
# With docker-compose these are set for you (the `tei` service runs bge-m3),
# so you normally only need ANTHROPIC_API_KEY above. Set them here only for a
# NON-Docker run, e.g.:
# EMBED_BASE_URL=http://localhost:8080/v1     # a TEI/hosted embeddings endpoint
# EMBED_MODEL=BAAI/bge-m3
# (index + query must use the SAME model; the chunks are embedded once and the
#  vectors cached on the /data volume, tagged with the model — changing
#  EMBED_MODEL re-embeds everything on the next start.)
#
# Optional cross-encoder reranker, applied after the hybrid (BM25 + dense)
# retrieval. A full TEI /rerank URL, e.g. a second TEI container running
# `--model-id BAAI/bge-reranker-v2-m3`. Unset → the hybrid order is used as is.
# RERANK_URL=http://tei-rerank:80/rerank

# ── Cost guard: hard per-IP hourly caps on the paid LLM endpoints ─────────
# On top of the short cooldown. 0 disables. Defaults: ask 40/h, translate 20/h.
# ASK_HOURLY_LIMIT=40
# TRANSLATE_HOURLY_LIMIT=20

# ── Comments moderation / anti-spam (optional) ───────────────────────────
# Set BOTH this secret AND the *build-time* NEXT_PUBLIC_TURNSTILE_SITE_KEY
# together, or neither — half-configured rejects every submission (403)
# instead of degrading to "pending". The site key can't go in this runtime
# .env (Next.js inlines it into the static export at build time); set it as
# the GitHub repo variable NEXT_PUBLIC_TURNSTILE_SITE_KEY (Settings → Actions
# → Variables) — see .github/workflows/docker.yml. Without either, comments
# are simply held as "pending" for manual moderation.
# TURNSTILE_SECRET_KEY=0x...
# Bearer token gating the admin list / approve / delete — also what you paste
# into /admin/ (comment moderation UI + a glance at the RAG index health):
# COMMENTS_ADMIN_TOKEN=change-me
# Pinged (plain-text POST, fire-and-forget) whenever a comment lands in the
# moderation queue, so you don't have to poll /admin. Any URL that accepts a
# plain-text body works, e.g. an ntfy.sh topic:
# COMMENT_WEBHOOK_URL=https://ntfy.sh/your-topic-here
# /admin's "version en ligne" and "santé du coffre" cards read two build-time
# reports baked into the image (defaults: data/build-info.json and
# data/vault-health.json under the working dir; the Dockerfile points them at
# /app/data). Missing files just show as "unknown" in /admin. The version card
# also queries api.github.com (unauthenticated, cached 10 min) for pensine's
# latest commit; without outbound access it shows "unknown".
# BUILD_INFO=/app/data/build-info.json
# VAULT_HEALTH=/app/data/vault-health.json
# "Prérequis suggérés" reads a third one the same way (scripts/prereq-suggestions.ts;
# missing file → the card says so).
# PREREQ_SUGGESTIONS=/app/data/prereq-suggestions.json
# "Faits à vérifier" reads a fourth (scripts/facts-to-check.ts, built from the
# vault's sources/a-verifier.md checklist; missing file → the card says so, an
# absent checklist → an empty list).
# FACTS_TO_CHECK=/app/data/facts-to-check.json
#
# "Recherches sans résultat" needs no configuration: zero-result searches are
# counted in the comments SQLite DB (DB_PATH) by the public POST /api/search-miss.
# "Banc d'essai de l'assistant" uses the RAG settings above (EMBED_BASE_URL,
# RERANK_URL); without EMBED_BASE_URL the card says it is disabled.

# ── Reader accounts (optional): magic-link login, progress sync, coins ─────
# Login is by an e-mailed link (no password). Accounts, sessions, synced
# progress, the coin ledger, streaks and bought avatar items all live in the
# same SQLite file as the comments (DB_PATH), so keep the /data volume.
# SMTP unset → GET /api/auth/config says {enabled:false}, the site hides the
# login button and POST /api/auth/request answers 503; everything else on the
# site works as before (progress stays in the browser).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587              # default 587 (STARTTLS); 465 → implicit TLS
# SMTP_SECURE=false          # default: true only when SMTP_PORT=465
# SMTP_USER=postmaster@example.com
# SMTP_PASS=...
# MAIL_FROM="Le Jardin <jardin@example.com>"   # default: SMTP_USER
# Local dev without SMTP: print each login link to the server log instead of
# mailing it (login then counts as enabled). Never in production — anyone
# who can read the log can log in as anyone.
# AUTH_DEV_LOG=true
# Base URL of the links in the mails and the Origin that account writes must
# come from. Default: the site's SITE_URL (lib/site.ts, SITE_BASE_URL at
# build). Set it for a local test, e.g. http://localhost:8085 (the session
# cookie is only marked Secure when this is https). Requests whose Origin
# matches the request's own Host are accepted too.
# PUBLIC_URL=http://localhost:8085
# The login form reuses Turnstile: with TURNSTILE_SECRET_KEY set (above), a
# valid token is required. /api/auth/config hands the form the public site key
# from TURNSTILE_SITE_KEY (or NEXT_PUBLIC_TURNSTILE_SITE_KEY if that is also
# in the runtime env); unset → no key in the config (the static site may still
# have it inlined at build).
# TURNSTILE_SITE_KEY=0x...

# ── /admin write actions on GitHub (optional) ────────────────────────────
# "Reconstruire le site": dispatches .github/workflows/docker.yml (on main) and
# lists its last runs. A fine-grained token with Actions: read and write on
# GITHUB_REPO. The workflow only pushes a new image — the server must still
# pull it and restart. Unset → the card shows the feature as disabled.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=rwmicro/learn-nebula
# "Accepter" on a prerequisite suggestion: commits the `prerequis:` edit to
# the vault on a new branch (prereq/<date>-<id>) and opens one pull request.
# A fine-grained token with Contents + Pull requests: read and write on
# PENSINE_REPO. Unset → falls back to GITHUB_TOKEN (give that token access to
# the vault too, then); neither set → the "Accepter" buttons are disabled
# (the "Copier" line still works).
# PENSINE_TOKEN=github_pat_...
# PENSINE_REPO=rwmicro/pensine

# ── TEI embeddings image architecture (docker-compose only) ──────────────
# HuggingFace ships NO combined multi-arch manifest for TEI's CPU build —
# amd64 and arm64 are two separate tag families. Default is amd64; on an
# arm64 host (Raspberry Pi, AWS Graviton, Apple Silicon VM…) override:
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest

