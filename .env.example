# Runtime config for the self-hosted server (docker run --env-file .env …).
# Copy to .env and fill in. Everything is optional; unset features degrade
# gracefully (the frontend already handles 503s and empty results).

# ── Server ───────────────────────────────────────────────────────────────
PORT=8085
# TRUST_PROXY=true          # X-Forwarded-For is authoritative (default). Set
                            # "false" only if NOT behind a reverse proxy.

# ── Generation (pick ONE; Anthropic wins if both are set) ────────────────
# A) Anthropic (Claude) — hosted, best quality. This is the docker-compose
#    default; only the key is needed here (GEN_MODEL/TRANSLATE_MODEL are set to
#    claude-sonnet-5 in docker-compose.yml — the best fit for grounded RAG Q&A;
#    use claude-opus-5 for max quality or claude-haiku-4-5 to save):
ANTHROPIC_API_KEY=sk-ant-...
# GEN_MODEL=claude-sonnet-5
# TRANSLATE_MODEL=claude-sonnet-5
#
# B) Or any OpenAI-compatible chat endpoint (Ollama, llama.cpp, LM Studio) —
#    local, free. Leave ANTHROPIC_API_KEY unset if you use this:
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=your-local-chat-model

# ── RAG retrieval embeddings (OpenAI-compatible /v1/embeddings) ───────────
# Unset → the assistant answers from the model alone (no note grounding).
# The chunks are embedded once at first run and cached on the /data volume, then
# only the question is embedded per query — so a CPU-only endpoint is plenty.
# Any embedding model works; index + query just have to use the SAME one.
#
# A) LM Studio (load an embedding model, start its local server on :1234). From
#    a Docker container add `--add-host=host.docker.internal:host-gateway`:
# EMBED_BASE_URL=http://host.docker.internal:1234/v1
# EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
#    (running the server directly, not in Docker, use http://localhost:1234/v1)
#
# B) The bundled Ollama service (pull an embedding model first):
# EMBED_BASE_URL=http://ollama:11434/v1
# EMBED_MODEL=bge-m3

# ── Comments moderation / anti-spam (optional) ───────────────────────────
# Set BOTH the build var NEXT_PUBLIC_TURNSTILE_SITE_KEY (at build time) and this
# secret together, or neither. Without it, comments are held as "pending".
# TURNSTILE_SECRET_KEY=0x...
# Bearer token gating the admin list / approve / delete:
# COMMENTS_ADMIN_TOKEN=change-me

# Runtime config for the self-hosted server (docker run --env-file .env …).
# Copy to .env and fill in. Everything is optional; unset features degrade
# gracefully (the frontend already handles 503s and empty results).

