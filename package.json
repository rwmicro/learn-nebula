{
  "name": "learn-nebula",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-pensine-index.mjs && next dev --webpack",
    "build": "node scripts/build-pensine-index.mjs && next build --webpack",
    "build:pages": "node scripts/build-pensine-index.mjs && node scripts/strip-binaries-for-build.mjs && next build --webpack",
    "start": "next start",
    "lint": "next lint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "index": "node scripts/build-pensine-index.mjs",
    "sync:r2": "./scripts/sync-r2.sh",
    "hooks:install": "./scripts/install-hooks.sh"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.6",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.1.6",
    "@types/mdx": "^2.0.13",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cssnano": "^6.1.2",
    "geist": "^1.3.0",
    "ignore-loader": "^0.1.2",
    "isomorphic-dompurify": "^2.35.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "mermaid": "^11.12.3",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.0",
    "sharp": "^0.33.3",
    "sql.js": "^1.13.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.1.8",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/learn-nebula"
  },
  "author": "Martin",
  "license": "MIT"
}
