{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "predev": "node scripts/bundle-js.mjs && node scripts/copy-mermaid.mjs && node scripts/copy-vault-images.mjs && node scripts/build-anki.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node scripts/fetch-notes.mjs && node scripts/bundle-js.mjs && node scripts/copy-mermaid.mjs && node scripts/copy-vault-images.mjs && node scripts/build-anki.mjs && next build && node scripts/render-mermaid.mjs && npx pagefind --site out && node scripts/index-notes.mjs",
    "index": "node scripts/index-notes.mjs",
    "start": "npx serve out",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test": "scripts/test.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@tailwindcss/postcss": "^4.3.1",
    "force-graph": "^1.51.4",
    "franc-min": "^6.2.0",
    "katex": "^0.16.11",
    "mermaid": "^11.15.0",
    "next": "^16.2.9",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.29.2",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260619.1",
    "@playwright/test": "^1.58.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.11.1",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hastscript": "^9.0.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "remark-smartypants": "^3.0.2",
    "serve": "^14.2.6",
    "smol-toml": "^1.3.1",
    "sql.js": "^1.14.1",
    "typescript": "^5.7.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.102.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  }
}
