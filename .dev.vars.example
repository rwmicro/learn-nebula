# Local dev config for the Pages Functions. Copy to `.dev.vars` (gitignored),
# then run the chat + translation locally against an OpenAI-compatible server
# such as LM Studio — no Anthropic key / Workers AI / Vectorize needed.
#
#   1. LM Studio → Developer → Start Server, load a model.
#   2. cp .dev.vars.example .dev.vars   (adjust LLM_MODEL to your loaded model id)
#   3. npx pnpm@10.28.0 build
#   4. npx wrangler pages dev out
#
# NOTE: /api/* Functions do NOT run under `next dev` — they only run under
# `wrangler pages dev`. When LLM_BASE_URL is set, /api/ask and /api/translate
# route generation here and SKIP semantic retrieval (the assistant answers from
# the model alone). Leave these unset in production.
#
# Use 127.0.0.1 (not localhost) so workerd doesn't try ::1 (IPv6) first.
# LLM_BASE_URL must include the /v1 suffix.
LLM_BASE_URL="http://127.0.0.1:1234/v1"
LLM_MODEL="your-loaded-model-id"
